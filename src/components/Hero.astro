---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import img1 from '../assets/services/fourniture_pose_carrelage_2.jpg';
import img2 from '../assets/services/renovation_2.jpg';
import img3 from '../assets/services/dale_sur_taquet_1.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, '');
---
<section class="hero">
  <div class="container grid">
    <div class="copy">
      <span class="kicker">{t('hero.kicker')}</span>
      <h1>{t('hero.title')}</h1>
      <p>{t('hero.text')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`${home}#contact`}>{t('hero.cta')}</a>
        <a class="btn btn-ghost" href={`${home}#prestations`}>{t('hero.cta2')}</a>
      </div>
      <a class="phone" href={site.phoneHref}>{t('hero.call')} · {site.phone}</a>
    </div>
    <div class="collage" aria-hidden="true">
      <Image class="p1" src={img1} alt="" widths={[480, 900]} sizes="(max-width: 900px) 90vw, 520px" loading="eager" />
      <Image class="p2" src={img2} alt="" widths={[320, 600]} sizes="260px" />
      <Image class="p3" src={img3} alt="" widths={[320, 600]} sizes="260px" />
      <div class="badge"><img src={`${import.meta.env.BASE_URL}/logo.svg`.replace(/\/\/+/g, "/")} alt="" width="72" height="72" /></div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 8vw, 5rem); overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  h1 { font-size: clamp(2.4rem, 5.2vw, 4rem); margin-top: 1rem; font-weight: 700; }
  .copy p { margin-top: 1.25rem; font-size: 1.15rem; color: var(--ink-2); max-width: 36rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .phone { display: inline-block; margin-top: 1.25rem; font-weight: 600; color: var(--brand-dark); text-decoration: none; }
  .phone:hover { text-decoration: underline; }

  .collage { position: relative; aspect-ratio: 1 / 1; max-width: 560px; justify-self: end; width: 100%; }
  .collage img { position: absolute; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .p1 { inset: 0 0 18% 12%; width: 88%; height: 82%; }
  .p2 { left: 0; bottom: 0; width: 46%; height: 42%; border: 6px solid var(--bg); }
  .p3 { right: 0; bottom: 4%; width: 36%; height: 34%; border: 6px solid var(--bg); }
  .badge {
    position: absolute; top: -6%; left: 2%; width: 104px; height: 104px; border-radius: 50%;
    background: #fff; display: grid; place-items: center; box-shadow: var(--shadow); border: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .collage { justify-self: stretch; max-width: none; margin-top: 2.5rem; }
  }
</style>
