---
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const points = [1, 2, 3] as const;
const icons = [
  '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>',
  '<path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="9"/>',
  '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
];
---
<section class="section about" id="about">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{t('nav.about')}</span>
      <h2>{t('about.title')}</h2>
      <p>{t('about.text')}</p>
    </div>
    <ul class="points">
      {points.map((n, i) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
          <h3>{t(`about.point${n}.title`)}</h3>
          <p>{t(`about.point${n}.text`)}</p>
        </li>
      ))}
    </ul>
    <div class="area">
      <h3>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        {t('area.title')}
      </h3>
      <ul class="places">
        {site.areas.map((p) => <li>{p}</li>)}
        <li class="all">{t('area.more')}</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { background: var(--brand); color: #fff; }
  .about .kicker { color: #fff; }
  .about .kicker::before { background: #fff; }
  .about .section-head p { color: rgb(255 255 255 / .9); }
  .points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
  .points li { background: rgb(255 255 255 / .12); border: 1px solid rgb(255 255 255 / .2); border-radius: var(--radius); padding: 1.5rem; }
  .points svg { width: 32px; height: 32px; margin-bottom: .9rem; }
  .points h3 { font-size: 1.15rem; margin-bottom: .4rem; }
  .points p { color: rgb(255 255 255 / .88); }

  .area {
    margin-top: 1.25rem; padding: 1.5rem; border-radius: var(--radius);
    background: rgb(255 255 255 / .12); border: 1px solid rgb(255 255 255 / .2);
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem;
  }
  .area h3 { display: inline-flex; align-items: center; gap: .6rem; font-size: 1.15rem; }
  .area h3 svg { width: 28px; height: 28px; flex: none; }
  .places { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .places li { background: #fff; color: var(--ink); padding: .4rem .95rem; border-radius: 999px; font-weight: 600; font-size: .95rem; }
  .places .all { background: transparent; color: #fff; border: 1.5px dashed rgb(255 255 255 / .7); }
</style>
