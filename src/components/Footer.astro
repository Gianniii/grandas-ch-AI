---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <div class="brand">
      <img src="/logo.svg" alt="" width="48" height="48" />
      <div>
        <strong>{site.name}</strong>
        <span>{site.tagline[lang]}</span>
      </div>
    </div>
    <address>
      {site.owner}<br />
      {site.address.map((l) => <>{l}<br /></>)}
      <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
    </address>
    <ul class="langs">
      {(Object.keys(languages) as Lang[]).map((l) => (
        <li><a href={getRelativeLocaleUrl(l, '')} aria-current={l === lang ? 'page' : undefined}>{languages[l]}</a></li>
      ))}
    </ul>
  </div>
  <div class="container bottom">© {year} {site.name}. {t('footer.rights')}</div>
</footer>

<style>
  .footer { background: var(--ink); color: #cfccc6; padding-top: 3.5rem; }
  .inner { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 2rem; padding-bottom: 2.5rem; border-bottom: 1px solid rgb(255 255 255 / .1); }
  .brand { display: flex; gap: .9rem; align-items: center; }
  .brand img { background: #fff; border-radius: 50%; padding: 2px; }
  .brand strong { display: block; color: #fff; font-family: var(--font-head); font-size: 1.3rem; letter-spacing: .05em; text-transform: uppercase; }
  address { font-style: normal; line-height: 1.8; }
  address a { color: #fff; text-decoration: none; }
  address a:hover { text-decoration: underline; }
  .langs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1rem; justify-self: end; align-content: start; }
  .langs a { text-decoration: none; }
  .langs a[aria-current] { color: var(--brand); font-weight: 600; }
  .bottom { padding-block: 1.25rem; font-size: .9rem; color: #8a8884; }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; }
    .langs { justify-self: start; }
  }
</style>
