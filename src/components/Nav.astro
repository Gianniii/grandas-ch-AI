---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, '');
const links = [
  { href: `${home}#prestations`, label: t('nav.services') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---
<header class="nav" id="top">
  <div class="container nav-inner">
    <a class="brand" href={home}>
      <img src={`${import.meta.env.BASE_URL}/logo.svg`.replace(/\/\/+/g, "/")} alt="" width="40" height="40" />
      <span>{site.name}</span>
    </a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label={t('nav.menu')}>
      <span></span><span></span><span></span>
    </button>

    <nav id="menu" class="menu">
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <details class="lang">
        <summary aria-label={t('nav.language')} title={t('nav.language')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{lang.toUpperCase()}</span>
        </summary>
        <ul>
          {(Object.keys(languages) as Lang[]).map((l) => (
            <li>
              <a href={getRelativeLocaleUrl(l, '')} aria-current={l === lang ? 'page' : undefined} lang={l}>{languages[l]}</a>
            </li>
          ))}
        </ul>
      </details>
      <a class="btn btn-primary call" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.8.3 1.7.6 2.6.7a2 2 0 0 1 1.7 2z"/></svg>
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgb(250 248 245 / .85);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font-family: var(--font-head); font-weight: 700; font-size: 1.35rem; letter-spacing: .04em; text-transform: uppercase; }
  .menu { display: flex; align-items: center; gap: 1.5rem; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; }
  .links { gap: 1.5rem; }
  .links a { text-decoration: none; font-weight: 500; color: var(--ink-2); }
  .links a:hover { color: var(--ink); }
  .lang { position: relative; }
  .lang summary { list-style: none; display: inline-flex; align-items: center; gap: .3rem; padding: .35rem .5rem; border-radius: 8px; font-size: .78rem; font-weight: 600; color: var(--ink-3); cursor: pointer; }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary:hover, .lang[open] summary { color: var(--ink); background: rgb(31 30 28 / .06); }
  .lang summary svg { width: 16px; height: 16px; }
  .lang ul { position: absolute; right: 0; top: calc(100% + .4rem); min-width: 150px; flex-direction: column; align-items: stretch; padding: .35rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); z-index: 60; }
  .lang ul a { display: block; padding: .5rem .75rem; border-radius: 8px; font-size: .9rem; text-decoration: none; color: var(--ink-2); }
  .lang ul a:hover { background: var(--bg); color: var(--ink); }
  .lang ul a[aria-current] { color: var(--ink); font-weight: 600; }
  .call { padding: .6rem 1.1rem; }
  .burger { display: none; background: none; border: 0; padding: .5rem; flex-direction: column; gap: 5px; }
  .burger span { display: block; width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .burger { display: flex; }
    .menu {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 1.25rem;
      padding: 1.25rem; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
    }
    .menu.open { display: flex; }
    .links { flex-direction: column; align-items: stretch; gap: 0; }
    .links a { display: block; padding: .75rem 0; font-size: 1.1rem; border-bottom: 1px solid var(--line); }
    .lang { align-self: center; }
    .lang ul { position: static; box-shadow: none; }
    .call { justify-content: center; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');
  burger?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(!!open));
  });
  const lang = document.querySelector<HTMLDetailsElement>('.lang');
  document.addEventListener('click', (e) => { if (lang?.open && !lang.contains(e.target as Node)) lang.open = false; });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
