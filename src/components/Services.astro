---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const altOf = (s: (typeof services)[number], i: number) =>
  s.data.images[i].alt?.[lang] ?? `${s.data[lang].title} – ${i + 1}`;
---
<section class="section" id="prestations">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{t('nav.services')}</span>
      <h2>{t('services.title')}</h2>
      <p>{t('services.lead')}</p>
    </div>

    <div class="cards">
      {services.map((s) => {
        const d = s.data[lang];
        const n = s.data.images.length;
        return (
          <article class="card">
            <button class="cover" type="button" data-open={`svc-${s.id}`} aria-label={`${d.title} – ${t('services.more')}`}>
              <Image src={s.data.images[0].src} alt={altOf(s, 0)} widths={[420, 840]} sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 380px" />
              <span class="count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                {n} {n > 1 ? t('services.photos') : t('services.photo')}
              </span>
            </button>
            <div class="body">
              <h3>{d.title}</h3>
              <p>{d.summary}</p>
              <button class="more" type="button" data-open={`svc-${s.id}`}>
                {t('services.more')}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

{/* One dialog per service: full gallery + description */}
{services.map((s) => {
  const d = s.data[lang];
  const n = s.data.images.length;
  return (
    <dialog class="lb" id={`svc-${s.id}`} aria-labelledby={`svc-${s.id}-title`}>
      <div class="lb-inner">
        <button class="lb-close" type="button" data-close aria-label={t('lightbox.close')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <div class="lb-gallery">
          <div class="lb-track" tabindex="0">
            {s.data.images.map((img, i) => (
              <figure class="lb-slide">
                <Image src={img.src} alt={altOf(s, i)} widths={[720, 1200, 1800]} sizes="(max-width: 900px) 95vw, 760px" loading="lazy" />
              </figure>
            ))}
          </div>
          {n > 1 && (
            <>
              <button class="lb-arrow prev" type="button" data-prev aria-label={t('lightbox.prev')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button class="lb-arrow next" type="button" data-next aria-label={t('lightbox.next')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
              <div class="lb-thumbs">
                {s.data.images.map((img, i) => (
                  <button type="button" data-goto={i} aria-label={`${i + 1}/${n}`} aria-current={i === 0 ? 'true' : undefined}>
                    <Image src={img.src} alt="" width={160} height={120} />
                  </button>
                ))}
              </div>
            </>
          )}
        </div>
        <div class="lb-text">
          <span class="kicker">{t('nav.services')}</span>
          <h3 id={`svc-${s.id}-title`}>{d.title}</h3>
          <p>{d.description}</p>
          {d.tip && <p class="tip">{d.tip}</p>}
          <p class="cta">{t('services.contactLine')}</p>
          <a class="btn btn-primary" href="#contact" data-close>{t('hero.cta')}</a>
        </div>
      </div>
    </dialog>
  );
})}

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: transform .2s ease, box-shadow .2s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .cover { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; aspect-ratio: 4 / 3; overflow: hidden; }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .cover img { transform: scale(1.04); }
  .count { position: absolute; left: .85rem; bottom: .85rem; display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .7rem; border-radius: 999px; background: rgb(31 30 28 / .72); color: #fff; font-size: .8rem; font-weight: 600; backdrop-filter: blur(6px); }
  .count svg { width: 1em; height: 1em; }
  .body { padding: 1.25rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  .body h3 { font-size: 1.3rem; }
  .body p { color: var(--ink-2); flex: 1; }
  .more { align-self: flex-start; margin-top: .5rem; display: inline-flex; align-items: center; gap: .4rem; background: none; border: 0; padding: 0; font-weight: 600; color: var(--brand-dark); }
  .more svg { width: 1.1em; height: 1.1em; transition: transform .2s; }
  .more:hover svg { transform: translateX(3px); }

  /* Lightbox dialog */
  .lb { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; }
  .lb::backdrop { background: rgb(31 30 28 / .7); backdrop-filter: blur(4px); }
  .lb[open] { display: grid; place-items: center; }
  .lb-inner { position: relative; width: min(100% - 1.5rem, 1200px); max-height: calc(100vh - 2rem); overflow: auto; background: var(--bg); border-radius: var(--radius); display: grid; grid-template-columns: 1.4fr 1fr; }
  .lb-close { position: absolute; top: .75rem; right: .75rem; z-index: 2; width: 42px; height: 42px; border-radius: 50%; border: 0; background: #fff; color: var(--ink); display: grid; place-items: center; box-shadow: var(--shadow); }
  .lb-close svg { width: 20px; height: 20px; }
  .lb-gallery { position: relative; background: #141312; }
  .lb-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 4 / 3; }
  .lb-track::-webkit-scrollbar { display: none; }
  .lb-slide { flex: 0 0 100%; margin: 0; scroll-snap-align: center; display: grid; place-items: center; }
  .lb-slide img { width: 100%; height: 100%; object-fit: contain; }
  .lb-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgb(255 255 255 / .9); color: var(--ink); display: grid; place-items: center; }
  .lb-arrow svg { width: 22px; height: 22px; }
  .lb-arrow.prev { left: .75rem; } .lb-arrow.next { right: .75rem; }
  .lb-thumbs { display: flex; gap: .5rem; padding: .75rem; overflow-x: auto; background: #141312; }
  .lb-thumbs button { flex: 0 0 72px; aspect-ratio: 4 / 3; padding: 0; border: 2px solid transparent; border-radius: 8px; overflow: hidden; background: none; opacity: .55; transition: opacity .2s, border-color .2s; }
  .lb-thumbs button img { width: 100%; height: 100%; object-fit: cover; }
  .lb-thumbs button[aria-current] { opacity: 1; border-color: var(--brand); }
  .lb-text { padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: 1rem; }
  .lb-text h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .lb-text p { color: var(--ink-2); }
  .lb-text .tip { padding: .9rem 1rem; border-left: 4px solid var(--brand); background: var(--brand-soft); border-radius: 8px; color: var(--ink); }
  .lb-text .cta { font-weight: 600; color: var(--ink); }
  .lb-text .btn { align-self: flex-start; }
  @media (max-width: 900px) {
    .lb-inner { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Open / close dialogs
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dlg = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      dlg?.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.lb').forEach((dlg) => {
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // click on backdrop

    // Gallery navigation
    const track = dlg.querySelector<HTMLElement>('.lb-track')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const thumbs = Array.from(dlg.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goto = (i: number) => {
      const n = slides.length;
      const idx = ((i % n) + n) % n;
      track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
    };
    dlg.querySelector('[data-prev]')?.addEventListener('click', () => goto(current() - 1));
    dlg.querySelector('[data-next]')?.addEventListener('click', () => goto(current() + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => goto(Number(t.dataset.goto))));
    track.addEventListener('scroll', () => {
      const i = current();
      thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    }, { passive: true });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goto(current() - 1);
      if (e.key === 'ArrowRight') goto(current() + 1);
    });
    dlg.addEventListener('close', () => track.scrollTo({ left: 0 }));
  });
</script>
